{
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "allow": [
      "Edit(game/**)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git pull --rebase)",
      "Bash(git revert --no-edit *)",
      "Bash(git restore --source=* game)",
      "Bash(git restore --source=* game/)",
      "Bash(cp -R templates/simple-platformer/. game/)",
      "Bash(cp -R templates/simple-maze/. game/)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Monitor",
      "Workflow",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset *)",
      "Bash(git config *)",
      "Bash(git remote *)"
    ]
  },
  "disableClaudeAiConnectors": true,
  "env": { "DISABLE_AUTOUPDATER": "1" }
}
